<div class="modal" id="userModal">
  <div class="modal-box">
    <h3>Add New User</h3>

    <div class="form-group">
      <input type="text" id="newUserName" placeholder="Enter username">
    </div>

    <div class="form-group">
      <input type="email" id="newUserEmail" placeholder="Enter Gmail address">
    </div>

    <div class="modal-actions">
      <button class="cancel" onclick="closeAddUser()">Cancel</button>
      <button class="save-user" onclick="addUser()">Add</button>
    </div>
  </div>
</div>

<script>
function showPage(pageId, element){
  document.querySelectorAll('.page').forEach(page => page.classList.remove('active'));
  document.getElementById(pageId).classList.add('active');

  document.querySelectorAll('.menu-item').forEach(item => item.classList.remove('active'));
  element.classList.add('active');
  if(pageId === 'reports') buildCalendar();
}

function toggleSidebar(){
  const sidebar = document.querySelector(".sidebar");
  sidebar.classList.toggle("collapsed");
  localStorage.setItem("sidebar", sidebar.classList.contains("collapsed"));
}

function filterUsers(){
  const input = document.getElementById("searchUser").value.toLowerCase();
  const rows = document.querySelectorAll("#userList .user-row");

  rows.forEach(row => {
    const name = row.querySelector(".user-name").textContent.toLowerCase();
    const email = row.querySelector(".user-email").textContent.toLowerCase();
    row.style.display = (name.includes(input) || email.includes(input)) ? "flex" : "none";
  });
}

function muteUser(btn){
  const isMuted = btn.dataset.muted === "true";

  if(!isMuted){
    btn.dataset.muted = "true";
    btn.textContent = "Unmute";
    btn.style.background = "#31244f";
    btn.style.color = "#fff";
    btn.style.borderColor = "#31244f";
  }else{
    btn.dataset.muted = "false";
    btn.textContent = "Mute";
    btn.style.background = "";
    btn.style.color = "";
    btn.style.borderColor = "";
  }
}

function kickUser(btn){
  const row = btn.closest('.user-row');
  row.style.opacity = "0";
  row.style.transform = "translateX(20px)";
  row.style.transition = ".3s ease";
  setTimeout(() => row.remove(), 300);
}

function toggleAll(master){
  document.querySelectorAll(".user-check").forEach(check => {
    check.checked = master.checked;
  });
}

function generateLink(){
  return "https://vincera.app/meet/" + Math.random().toString(36).substring(2,8);
}

function inviteAllUsers(){
  const rows = document.querySelectorAll("#userList .user-row");
  let selectedEmails = [];

  rows.forEach(row => {
    const checkbox = row.querySelector(".user-check");
    if(checkbox && checkbox.checked){
      selectedEmails.push(row.querySelector(".user-email").textContent.trim());
    }
  });

  if(selectedEmails.length === 0){
    alert("Select at least one user");
    return;
  }

  const link = generateLink();
  const subject = encodeURIComponent("Meeting Invitation");
  const body = encodeURIComponent("Hello,\n\nYou are invited to join the meeting.\n\nMeeting Link:\n" + link);

  window.open(`https://mail.google.com/mail/?view=cm&fs=1&to=${selectedEmails.join(",")}&su=${subject}&body=${body}`, "_blank");
}

function showPermissionTab(tabId, element){
  document.querySelectorAll('.permission-content').forEach(tab => tab.classList.remove('active'));
  document.getElementById(tabId).classList.add('active');

  document.querySelectorAll('.permission-tab').forEach(btn => btn.classList.remove('active'));
  element.classList.add('active');
}

function savePermissions(btn){
  btn.classList.add("saved");
  btn.innerHTML = '<i class="fa-solid fa-check"></i> Saved';

  setTimeout(() => {
    btn.classList.remove("saved");
    btn.innerHTML = btn.textContent.includes("Settings") ? "Save Settings" : "Save Changes";
  }, 1200);
}

function openAddUser(){
  document.getElementById("userModal").classList.add("active");
}

function closeAddUser(){
  document.getElementById("userModal").classList.remove("active");
  document.getElementById("newUserName").value = "";
  document.getElementById("newUserEmail").value = "";
}

function addUser(){
  const name = document.getElementById("newUserName").value.trim();
  const email = document.getElementById("newUserEmail").value.trim();

  if(name === ""){
    alert("Enter username");
    return;
  }

  if(email === ""){
    alert("Enter Gmail address");
    return;
  }

  const row = document.createElement("div");
  row.className = "user-row";

  row.innerHTML = `
    <div class="user-left">
      <input type="checkbox" class="user-check">
      <div class="user-info">
        <div class="user-name">${name}</div>
        <div class="user-email">${email}</div>
      </div>
    </div>

    <div class="action-group">
      <button class="action-btn" onclick="muteUser(this)">Mute</button>
      <button class="action-btn" onclick="kickUser(this)">Kick</button>
    </div>
  `;

  document.getElementById("userList").prepend(row);
  closeAddUser();
}

function renderUsers(){
  const userList = document.getElementById("userList");

  const users = [
    { name:"User 1", email:"user1@gmail.com" },
    { name:"User 2", email:"user2@gmail.com" },
    { name:"User 3", email:"user3@gmail.com" },
    { name:"User 4", email:"user4@gmail.com" },
    { name:"User 5", email:"user5@gmail.com" },
    { name:"User 6", email:"user6@gmail.com" },
    { name:"User 7", email:"user7@gmail.com" }
  ];

  users.forEach(user => {
    const row = document.createElement("div");
    row.className = "user-row";

    row.innerHTML = `
      <div class="user-left">
        <input type="checkbox" class="user-check">
        <div class="user-info">
          <div class="user-name">${user.name}</div>
          <div class="user-email">${user.email}</div>
        </div>
      </div>

      <div class="action-group">
        <button class="action-btn" onclick="muteUser(this)">Mute</button>
        <button class="action-btn" onclick="kickUser(this)">Kick</button>
      </div>
    `;

    userList.appendChild(row);
  });
}

let selectedDate = "all";
let selectedHost = "all";

let currentCalendarDate = new Date();
currentCalendarDate.setDate(1);

function openSlide(panelId, btn){
  const panel = document.getElementById(panelId);
  const alreadyOpen = panel.classList.contains('open');

  if(alreadyOpen){
    closeSlides();
    return;
  }

  closeSlides();

  if(panelId === 'calendarPanel') buildCalendar();

  if(btn){
    const rect = btn.getBoundingClientRect();
    panel.style.top = (rect.bottom + 6) + 'px';
    panel.style.left = rect.left + 'px';
    btn.classList.add('active');
  }

  panel.classList.add('open');
}

function closeSlides(){
  document.querySelectorAll('.slide-panel').forEach(panel => panel.classList.remove('open'));
  document.querySelectorAll('.filter-pill').forEach(pill => pill.classList.remove('active'));
}

function buildCalendar(){
  const grid = document.getElementById('calendarGrid');
  const title = document.getElementById('calendarMonthTitle');
  if(!grid || !title) return;

  const monthName = currentCalendarDate.toLocaleString('en-US', { month:'long' });
  const year = currentCalendarDate.getFullYear();
  const month = currentCalendarDate.getMonth();
  const today = new Date();

  title.textContent = `${monthName} ${year}`;

  grid.innerHTML = `
    <div class="day-name">Sun</div><div class="day-name">Mon</div><div class="day-name">Tue</div><div class="day-name">Wed</div><div class="day-name">Thu</div><div class="day-name">Fri</div><div class="day-name">Sat</div>
  `;

  const firstDay = new Date(year, month, 1).getDay();
  const totalDays = new Date(year, month + 1, 0).getDate();

  for(let i=0;i<firstDay;i++){
    const empty = document.createElement('div');
    empty.className = 'empty-cell';
    grid.appendChild(empty);
  }

  for(let day=1; day<=totalDays; day++){
    const cell = document.createElement('div');
    cell.className = 'date-cell';
    cell.textContent = day;

    const formatted = `${monthName} ${day},${year}`;
    if(selectedDate === formatted) cell.classList.add('selected');
    if(today.getDate() === day && today.getMonth() === month && today.getFullYear() === year){
      cell.classList.add('today');
    }

    cell.onclick = function(){
      document.querySelectorAll('.date-cell').forEach(x => x.classList.remove('selected'));
      this.classList.add('selected');
      selectedDate = formatted;
      document.getElementById('calendarText').textContent = formatted;
      closeSlides();
    };

    grid.appendChild(cell);
  }
}

function changeCalendarMonth(step){
  currentCalendarDate.setMonth(currentCalendarDate.getMonth() + step);
  buildCalendar();
}

function selectHost(value, label, element){
  selectedHost = value;
  document.getElementById('hostText').textContent = label;
  document.querySelectorAll('#hostPanel .choice-pill').forEach(pill => pill.classList.remove('selected'));
  element.classList.add('selected');
  closeSlides();
}


document.addEventListener('click', function(e){
  if(!e.target.closest('.slide-panel') && !e.target.closest('.filter-pill')){
    closeSlides();
  }
});

function filterReports(){
  const rows = document.querySelectorAll("#reportTable tr");

  rows.forEach(row => {
    const rowHost = row.children[1].textContent.trim();
    const rowDate = row.children[2].textContent.trim();
    const dateMatch = selectedDate === "all" || rowDate === selectedDate;
    const hostMatch = selectedHost === "all" || rowHost === selectedHost;

    row.style.display = dateMatch && hostMatch ? "" : "none";
  });
}

function viewReport(btn){
  const row = btn.closest('tr');
  document.getElementById('detailMeetingId').textContent = row.children[0].textContent;
  document.getElementById('detailHost').textContent = row.children[1].textContent;
  document.getElementById('detailDate').textContent = row.children[2].textContent.replace(',', ' ');
  document.getElementById('detailDuration').textContent = row.children[3].textContent.replace('mins', 'Mins');

  document.getElementById('reportListView').classList.add('hidden');
  document.getElementById('reportDetailsView').classList.remove('hidden');
  closeSlides();
}

function backToReports(){
  document.getElementById('reportDetailsView').classList.add('hidden');
  document.getElementById('reportListView').classList.remove('hidden');
}

function deleteReport(btn){
  const row = btn.closest("tr");
  row.style.transition = ".3s ease";
  row.style.opacity = "0";
  row.style.transform = "translateX(20px)";

  setTimeout(() => row.remove(), 300);
}

function toggleDarkMode(input){
  if(input.checked){
    document.body.style.background = "#171022";
  }else{
    document.body.style.background = "#dbe2ea";
  }
}

document.getElementById("userModal").addEventListener("click", function(e){
  if(e.target.id === "userModal"){
    closeAddUser();
  }
});


function openSettingsPanel(panelId){
  document.querySelectorAll('#settings .settings-inline-panel').forEach(panel => {
    if(panel.id !== panelId) panel.classList.remove('active');
  });
  const panel = document.getElementById(panelId);
  if(panel) panel.classList.toggle('active');
}

function closeSettingsPanels(){
  document.querySelectorAll('#settings .settings-inline-panel').forEach(panel => panel.classList.remove('active'));
}

function saveRadioSetting(name, labelId, panelId){
  const checked = document.querySelector(`input[name="${name}"]:checked`);
  if(checked){
    document.getElementById(labelId).textContent = checked.value;
  }
  document.getElementById(panelId).classList.remove('active');
}

function selectLang(btn, lang){
  document.querySelectorAll('.lang-option').forEach(option => {
    option.classList.remove('selected');
    const icon = option.querySelector('i:last-child');
    if(icon){ icon.className = 'fa-regular fa-circle'; }
  });
  btn.classList.add('selected');
  const icon = btn.querySelector('i:last-child');
  if(icon){ icon.className = 'fa-solid fa-check-circle'; }
  document.getElementById('languageSelected').textContent = lang;
}

function saveLanguage(){
  document.getElementById('languagePanel').classList.remove('active');
}

function showDeleteConfirm(){
  const text = document.getElementById('deleteText').value.trim();
  const pass = document.getElementById('deletePassword').value.trim();
  if(text !== 'DELETE'){
    alert('Please type DELETE to confirm');
    return;
  }
  if(pass === ''){
    alert('Please enter your password');
    return;
  }
  document.getElementById('deletePanel').classList.remove('active');
  document.getElementById('confirmDeletePanel').classList.add('active');
}

function confirmDeleteAccount(){
  alert('Account delete confirmed');
  closeSettingsPanels();
}

window.onload = function(){
  if(localStorage.getItem("sidebar") === "true"){
    document.querySelector(".sidebar").classList.add("collapsed");
  }

  renderUsers();
};
</script>

