<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Control Panel</title>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap');

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:'Manrope',sans-serif;
}

body{
  background:#dbe2ea;
  min-height:100vh;
  display:flex;
  color:#2f254a;
  overflow:hidden;
}

.sidebar{
  width:190px;
  min-height:100vh;
  background:#271947;
  color:#fff;
  padding:18px 0;
  flex-shrink:0;
  transition:0.3s ease;
}

.sidebar.collapsed{ width:70px; }

.sidebar.collapsed .brand-title,
.sidebar.collapsed .brand-sub,
.sidebar.collapsed .menu-item span{ display:none; }

.sidebar.collapsed .menu-item{ justify-content:center; }
.sidebar.collapsed .sidebar-head{ justify-content:center; }
.sidebar.collapsed .collapse-icon{ margin-left:0; }
.sidebar.collapsed .collapse-icon i{ transform:rotate(180deg); }

.sidebar-top{ padding:18px 22px 22px; }

.sidebar-head{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:10px;
}

.brand-title{
  font-size:17px;
  font-weight:500;
  line-height:1.2;
}

.brand-sub{
  font-size:10px;
  color:#b8b2c8;
  margin-top:2px;
}

.collapse-icon{
  font-size:11px;
  margin-top:4px;
  color:#fff;
  cursor:pointer;
}

.collapse-icon i{ transition:0.3s ease; }

.menu{
  display:flex;
  flex-direction:column;
  gap:6px;
  padding:0 8px;
  margin-top:8px;
}

.menu-item{
  display:flex;
  align-items:center;
  gap:8px;
  padding:10px 10px;
  border-radius:999px;
  color:#fff;
  text-decoration:none;
  font-size:14px;
  font-weight:500;
  cursor:pointer;
  transition:0.25s ease;
}

.menu-item i{
  width:12px;
  font-size:10px;
  text-align:center;
}

.menu-item:hover{ background:rgba(255,255,255,0.08); }

.menu-item.active{
  background:#f3f3f4;
  color:#271947;
}

.main{
  flex:1;
  padding:28px 34px;
  overflow-y:auto;
}

.main::-webkit-scrollbar,
.user-scroll::-webkit-scrollbar,
.engagement-list::-webkit-scrollbar,
.report-scroll::-webkit-scrollbar{
  width:6px;
}

.main::-webkit-scrollbar-thumb,
.user-scroll::-webkit-scrollbar-thumb,
.engagement-list::-webkit-scrollbar-thumb,
.report-scroll::-webkit-scrollbar-thumb{
  background:#9a9a9a;
  border-radius:10px;
}

.page{ display:none; }

.page.active{
  display:block;
  animation:fadeUp .45s ease;
}

@keyframes fadeUp{
  from{ opacity:0; transform:translateY(18px); }
  to{ opacity:1; transform:translateY(0); }
}

.dashboard-title,
.page-title,
.section-title{
  color:#372d56;
  font-weight:700;
}

.dashboard-title{
  font-size:22px;
  margin-bottom:22px;
}

.page-title{
  font-size:26px;
  margin-bottom:6px;
}

.page-subtitle{
  font-size:12px;
  color:#80838d;
  margin-bottom:26px;
}

.section-title{
  font-size:18px;
  margin-bottom:0;
}

.card{
  background:#f5f5f5;
  border-radius:18px;
  padding:28px 26px;
  margin-bottom:16px;
  border:1px solid #ececec;
}

.attention-text{
  font-size:18px;
  font-weight:700;
  color:#111;
}

.engagement-title{
  font-size:15px;
  font-weight:700;
  color:#1f1f1f;
  margin-bottom:16px;
}

.engagement-list{
  max-height:145px;
  overflow-y:auto;
  padding-right:6px;
}

.engagement-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:6px 4px;
  font-size:13px;
  color:#666;
  border-radius:10px;
}

.green{ color:#31d843; }
.red{ color:#ff3b30; }
.yellow{ color:#d6c12d; }

.title-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:20px;
  gap:12px;
  flex-wrap:wrap;
}

.top-action-buttons{
  display:flex;
  gap:10px;
  align-items:center;
  flex-wrap:wrap;
}

.top-btn{
  height:30px;
  padding:0 14px;
  border:1.2px solid #7e7e88;
  border-radius:999px;
  background:transparent;
  color:#2f254a;
  font-size:11px;
  font-weight:600;
  cursor:pointer;
  transition:0.25s ease;
  display:flex;
  align-items:center;
  gap:6px;
}

.top-btn:hover,
.action-btn:hover,
.save-btn:hover{
  background:#31244f;
  color:#fff;
  border-color:#31244f;
}

/* USER MANAGEMENT */
.user-box{
  background:#f5f5f5;
  border-radius:24px;
  padding:18px;
  border:1px solid #e5e5e5;
}

.inner-user-panel{
  border:1.3px solid #9d9da8;
  border-radius:20px;
  padding:12px 14px 16px;
}

.top-tools{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  margin-bottom:10px;
  flex-wrap:wrap;
}

.select-all-label{
  font-size:12px;
  display:flex;
  align-items:center;
  gap:6px;
  color:#372d56;
}

.search-box{
  position:relative;
  display:inline-block;
}

.search-box i{
  position:absolute;
  left:10px;
  top:50%;
  transform:translateY(-50%);
  font-size:10px;
  color:#7a7a85;
}

.search-box input{
  width:130px;
  height:24px;
  border:1.2px solid #8a8a94;
  border-radius:999px;
  padding-left:28px;
  padding-right:10px;
  font-size:10px;
  background:transparent;
  outline:none;
  color:#372d56;
}

.divider{
  height:1px;
  width:100%;
  background:#c1c1c7;
  margin-bottom:12px;
}

.user-scroll{
  max-height:290px;
  overflow-y:auto;
  padding-right:4px;
}

.user-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  padding:8px 4px;
  border-radius:12px;
  flex-wrap:wrap;
}

.user-left{
  display:flex;
  align-items:center;
  gap:10px;
}

.user-info{
  display:flex;
  flex-direction:column;
  gap:2px;
}

.user-name{
  font-size:16px;
  font-weight:500;
  color:#2f254a;
}

.user-email{
  font-size:11px;
  color:#7f8390;
}

.action-group{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
}

.action-btn{
  min-width:58px;
  height:24px;
  border:1.2px solid #7e7e88;
  border-radius:999px;
  background:transparent;
  color:#2f254a;
  font-size:12px;
  cursor:pointer;
  transition:0.25s ease;
  padding:0 12px;
}

/* REPORT PAGE */
.report-box{
  background:#f5f5f5;
  border-radius:24px;
  padding:18px;
  border:1px solid #e5e5e5;
  max-width:900px;
}

.report-inner{
  border:1.3px solid #9d9da8;
  border-radius:20px;
  padding:12px 16px 18px;
}

.report-filter-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  flex-wrap:wrap;
  margin-bottom:10px;
}

.report-selects{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
}

.report-select,
.report-filter-btn{
  height:24px;
  min-width:120px;
  border:1.2px solid #7e7e88;
  border-radius:999px;
  background:transparent;
  color:#372d56;
  font-size:10px;
  outline:none;
  padding:0 14px;
  cursor:pointer;
}

.report-filter-btn{
  min-width:95px;
  font-weight:700;
  transition:.25s ease;
}

.report-filter-btn:hover{
  background:#31244f;
  color:#fff;
}

.report-line{
  height:1px;
  width:100%;
  background:#c1c1c7;
  margin-bottom:12px;
}

.report-scroll{
  max-height:260px;
  overflow-y:auto;
  padding-right:8px;
}

.report-table{
  width:100%;
  border-collapse:collapse;
  color:#372d56;
}

.report-table thead tr{
  border:1.2px solid #8f8f9a;
}

.report-table th{
  font-size:13px;
  font-weight:700;
  padding:10px 12px;
  text-align:left;
}

.report-table td{
  font-size:12px;
  padding:9px 12px;
  color:#2f254a;
}

.status{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-width:75px;
  height:20px;
  border-radius:999px;
  border:1px solid #7e7e88;
  font-size:10px;
}

.delete-btn{
  min-width:65px;
  height:22px;
  border-radius:999px;
  border:1px solid #7e7e88;
  background:transparent;
  color:#2f254a;
  font-size:10px;
  cursor:pointer;
  transition:.25s ease;
}

.delete-btn:hover{
  background:#d93025;
  color:#fff;
  border-color:#d93025;
}



/* REPORT LIGHT DESIGN WITH SLIDE FILTERS */
.filter-pill{
  height:24px;
  min-width:117px;
  border:1.2px solid #7e7e88;
  background:transparent;
  color:#372d56;
  border-radius:999px;
  font-size:10px;
  outline:none;
  cursor:pointer;
  padding:0 13px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  transition:.25s ease;
}
.filter-pill:hover,
.filter-pill.active{
  background:#31244f;
  color:#fff;
  border-color:#31244f;
}
.filter-pill i{font-size:9px;transition:.25s ease;}
.filter-pill.active i{transform:rotate(180deg);}
.view-btn{
  min-width:56px;
  height:20px;
  border-radius:999px;
  border:1.2px solid #7e7e88;
  background:transparent;
  color:#2f254a;
  font-size:9px;
  cursor:pointer;
  transition:.25s ease;
}
.view-btn:hover{
  background:#31244f;
  color:#fff;
  border-color:#31244f;
  transform:scale(1.05);
}
.slide-panel{
  position:fixed;
  width:268px;
  min-height:250px;
  background:#f5f5f5;
  color:#372d56;
  border:1.2px solid #cbc8cf;
  border-radius:22px;
  padding:14px 16px;
  z-index:1000;
  transform:translateY(10px) scale(.97);
  opacity:0;
  pointer-events:none;
  transition:.25s cubic-bezier(.2,.9,.2,1);
  box-shadow:0 18px 45px rgba(49,36,79,.20);
}
.slide-panel.open{transform:translateY(0) scale(1);opacity:1;pointer-events:auto;}
.slide-panel.host-panel{min-height:225px;width:240px;}
.slide-title{display:flex;align-items:center;justify-content:space-between;font-size:13px;font-weight:700;margin-bottom:15px;color:#372d56;}
.slide-title .back{cursor:pointer;font-size:18px;font-weight:600;color:#372d56;}
.slide-title .next{cursor:pointer;font-size:18px;color:#372d56;}
.choice-pill{
  height:30px;
  border:1.2px solid #7e7e88;
  border-radius:999px;
  display:flex;
  align-items:center;
  justify-content:center;
  position:relative;
  margin:8px 0;
  font-size:10px;
  cursor:pointer;
  transition:.25s ease;
  color:#372d56;
  background:#fff;
}
.choice-pill:hover{background:#eeeaf7;transform:translateX(3px);}
.choice-pill .radio{
  position:absolute;
  right:16px;
  width:14px;
  height:14px;
  border:1.2px solid #7e7e88;
  border-radius:50%;
  background:#fff;
}
.choice-pill.selected{background:#31244f;color:#fff;border-color:#31244f;}
.choice-pill.selected .radio{border-color:#fff;background:#fff;}
.choice-pill.selected .radio::after{
  content:'\f00c';
  font-family:'Font Awesome 6 Free';
  font-weight:900;
  width:14px;
  height:14px;
  border-radius:50%;
  background:#b8b2c8;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:8px;
  color:#fff;
  margin:-1px 0 0 -1px;
}
.choice-label{font-size:13px;margin:12px 0 6px;color:#372d56;}
.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:13px 16px;text-align:center;font-size:11px;color:#372d56;}
.calendar-grid .day-name{font-size:10px;font-weight:700;margin-bottom:5px;color:#372d56;}
.calendar-grid .date-cell{height:20px;display:flex;align-items:center;justify-content:center;border-radius:50%;cursor:pointer;transition:.2s ease;}
.calendar-grid .date-cell:hover,.calendar-grid .date-cell.selected{background:#31244f;color:#fff;}
.calendar-grid .today{border:1.2px solid #31244f;}
.calendar-grid .empty-cell{height:20px;}
.report-list-view.hidden,
.report-details-view.hidden{display:none;}
.report-details-view{animation:fadeUp .35s ease;}
.details-back{
  border:0;
  background:transparent;
  color:#372d56;
  font-size:18px;
  cursor:pointer;
  margin-right:12px;
}
.details-title-row{
  display:flex;
  align-items:center;
  margin-bottom:14px;
}
.details-title-row h1{
  color:#372d56;
  font-size:24px;
  font-weight:700;
}
.details-info{
  margin-left:38px;
  margin-bottom:22px;
  color:#372d56;
  font-size:15px;
  line-height:1.55;
}
.analytics-heading{
  color:#372d56;
  font-size:18px;
  font-weight:700;
  margin-bottom:16px;
}
.analytics-box{
  background:#f5f5f5;
  border:1.3px solid #9d9da8;
  border-radius:22px;
  padding:22px 28px;
  max-width:735px;
  height:350px;
  overflow-y:auto;
}
.analytics-box::-webkit-scrollbar{width:6px;}
.analytics-box::-webkit-scrollbar-thumb{background:#9a9a9a;border-radius:10px;}
.participant-card{
  width:590px;
  max-width:100%;
  min-height:86px;
  border:1.3px solid #9d9da8;
  border-radius:22px;
  padding:14px 22px;
  display:flex;
  align-items:center;
  gap:18px;
  margin:10px 0 22px;
  color:#372d56;
  background:#fff;
}
.avatar-circle{
  width:52px;
  height:52px;
  border-radius:50%;
  background:#f4f4f7;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#31244f;
  font-size:30px;
  flex-shrink:0;
}
.participant-info{flex:1;font-size:13px;line-height:1.35;}
.participant-info strong{font-size:14px;display:block;margin-bottom:2px;}
.participant-stats{font-size:13px;line-height:1.45;min-width:95px;}
.video-status{
  min-width:76px;
  height:22px;
  border-radius:999px;
  border:0;
  color:#fff;
  font-size:9px;
  padding:0 12px;
}
.video-on{background:#24cf64;}
.partial{background:#1e9e51;}
.video-off{background:#df2c33;}
@media(max-width:900px){
  .report-filter-row,.report-selects{flex-wrap:wrap;}
  .slide-panel{width:82%;}
  .analytics-box{height:auto;max-height:360px;}
}

/* PERMISSIONS + SETTINGS */
.permission-tabs{
  display:flex;
  align-items:center;
  background:#f5f5f5;
  border:1.2px solid #c8c6cb;
  border-radius:999px;
  width:332px;
  max-width:100%;
  height:38px;
  padding:3px;
  margin-bottom:38px;
}

.permission-tab{
  flex:1;
  height:30px;
  border:none;
  background:transparent;
  border-radius:999px;
  font-size:12px;
  color:#3c3551;
  cursor:pointer;
  transition:0.25s ease;
}

.permission-tab.active{
  background:#31244f;
  color:#fff;
}

.permission-content{ display:none; }
.permission-content.active{ display:block; }

.permission-grid,
.settings-grid{
  display:grid;
  grid-template-columns:repeat(2, minmax(260px, 1fr));
  gap:26px 34px;
  max-width:700px;
  margin:0 auto;
}

.permission-card,
.setting-card{
  background:#f7f7f7;
  border:1.2px solid #cbc8cf;
  border-radius:26px;
  min-height:113px;
  padding:18px 18px 16px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
}

.permission-card h3,
.setting-card h3{
  font-size:15px;
  font-weight:700;
  color:#372d56;
  margin-bottom:8px;
}

.permission-card p,
.setting-card p{
  font-size:11px;
  color:#343434;
  line-height:1.4;
}

.switch{
  position:relative;
  width:40px;
  height:18px;
  margin-top:14px;
  display:inline-block;
}

.switch input{
  opacity:0;
  width:0;
  height:0;
}

.slider{
  position:absolute;
  inset:0;
  background:#c9ccd6;
  border-radius:999px;
  transition:0.35s ease;
  cursor:pointer;
}

.slider:before{
  content:"";
  position:absolute;
  height:14px;
  width:14px;
  left:2px;
  top:2px;
  background:#fff;
  border-radius:50%;
  transition:0.35s ease;
}

.switch input:checked + .slider{
  background:#31244f;
}

.switch input:checked + .slider:before{
  transform:translateX(22px);
}

/* Save Changes button fixed bottom-right */
.save-wrap{
  position:fixed;
  bottom:32px;
  right:38px;
  z-index:100;
}

.save-btn{
  min-width:134px;
  height:38px;
  border:1px solid transparent;
  border-radius:999px;
  background:#31244f;
  color:#fff;
  font-size:12px;
  font-weight:700;
  cursor:pointer;
  transition:0.25s ease;
}

.save-btn.saved{
  background:#28a745;
  border-color:#28a745;
}



/* NEW SETTINGS PAGE DESIGN */
.settings-vincera-page{
  background:#11081f;
  color:#fff;
  min-height:calc(100vh - 56px);
  border-radius:0;
  padding:26px 32px 34px;
  max-width:980px;
  margin:0 auto;
  box-shadow:0 18px 45px rgba(15,8,31,.18);
}
.settings-topbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:4px;
}
.settings-logo{
  font-size:17px;
  font-weight:800;
  letter-spacing:.2px;
}
.settings-logout{
  color:#fff;
  text-decoration:none;
  font-size:11px;
  display:flex;
  align-items:center;
  gap:4px;
  opacity:.95;
  cursor:pointer;
}
.settings-heading{
  margin-left:50px;
  font-size:15px;
  font-weight:800;
  margin-bottom:26px;
}
.settings-list{
  display:flex;
  flex-direction:column;
  gap:22px;
}
.v-setting-card{
  border:1.2px solid rgba(255,255,255,.75);
  background:#2b263d;
  border-radius:14px;
  padding:14px 20px 18px;
  min-height:76px;
  animation:settingFade .45s ease both;
}
@keyframes settingFade{
  from{opacity:0; transform:translateY(12px)}
  to{opacity:1; transform:translateY(0)}
}
.v-setting-card h3{
  font-size:13px;
  font-weight:800;
  margin-bottom:8px;
  color:#fff;
}
.v-setting-row{
  display:grid;
  grid-template-columns:1fr auto;
  align-items:center;
  gap:20px;
  min-height:24px;
  margin:3px 0;
}
.v-setting-row span,
.v-setting-row label{
  font-size:11px;
  color:#f0edf6;
}
.v-switch{
  position:relative;
  width:30px;
  height:15px;
  display:inline-block;
}
.v-switch input{display:none;}
.v-switch span{
  position:absolute;
  inset:0;
  border-radius:999px;
  background:#05020a;
  cursor:pointer;
  transition:.25s ease;
}
.v-switch span:before{
  content:"";
  position:absolute;
  width:8px;
  height:8px;
  left:4px;
  top:3.5px;
  background:#ddd;
  border-radius:50%;
  transition:.25s ease;
}
.v-switch input:checked + span{background:#35d978;}
.v-switch input:checked + span:before{transform:translateX(14px); background:#fff;}
.settings-select-btn{
  min-width:112px;
  height:24px;
  border:0;
  border-radius:999px;
  background:#130b26;
  color:#fff;
  font-size:9px;
  padding:0 10px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:8px;
  cursor:pointer;
}
.settings-select-btn i{font-size:8px;}
.delete-small-btn{
  width:92px;
  height:28px;
  border:0;
  border-radius:4px;
  background:#130b26;
  color:#fff;
  font-size:10px;
  cursor:pointer;
  transition:.25s ease;
}
